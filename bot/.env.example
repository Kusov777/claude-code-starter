# Переменные окружения для бота Telegram Prorabchik
# Скопируй значения и измени на свои!

# Токен бота (получи от @BotFather в Telegram)
TELEGRAM_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# Твой ID пользователя (узнай через @userinfobot)
ALLOWED_USER_ID=987654321

# Таймаут выполнения команды (в секундах)
COMMAND_TIMEOUT=30
